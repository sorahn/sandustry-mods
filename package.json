{
  "name": "sandustry-mods",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "tsc": "tsc --noEmit",
    "lint": "node scripts/check-jsx.mjs && oxlint --ignore-pattern '**/build/**' --ignore-pattern 'resources/**' --ignore-pattern '*.zip' tests scripts types mods",
    "check": "npm run tsc && npm run lint && npm run test:catalog",
    "test:blueprint": "bun test packages/sandustry-blueprint-core/src",
    "test:blueprint-svg": "bun test scripts/test-blueprint-svg-snapshots.test.ts",
    "test:blueprint-node": "bun test scripts/test-blueprint-node.test.ts",
    "test:catalog": "bun test scripts/test-catalog-invariants.test.ts",
    "test": "bun test packages/sandustry-blueprint-core/src apps/blueprint-site/src scripts/*.test.ts",
    "test:all": "npm run tsc && npm run lint && npm run test && npm --workspace @sandustry/blueprint-core run tsc && npm --workspace @sandustry/blueprint-node run tsc && npm --workspace @sandustry/blueprint-node run lint && npm --workspace apps/blueprint-site run tsc && npm run visual:diff",
    "test:bun:site": "npm --workspace apps/blueprint-site run test",
    "visual:render": "bun scripts/render-blueprint-visual.mjs",
    "visual:diff": "bun scripts/render-blueprint-visual.mjs --diff",
    "visual:update": "bun scripts/render-blueprint-visual.mjs --update",
    "catalog:extract": "node scripts/extract-native-catalog.mjs",
    "format:bundles": "node scripts/format-bundles.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  }
}
