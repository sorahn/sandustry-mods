{
  "name": "sandustry-mods",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "catalog:extract": "node scripts/extract-native-catalog.mjs",
    "mcp:sandustry": "node scripts/mcp/sandustry-server.mjs",
    "check": "npm run tsc && npm run tsc:tests && npm run lint && npm test",
    "format:bundles": "node scripts/format-bundles.mjs",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "lint": "node scripts/check-jsx.mjs && oxlint --ignore-pattern '**/build/**' --ignore-pattern 'resources/**' --ignore-pattern '*.zip' tests scripts types mods",
    "prepare": "husky",
    "test:all": "npm test && npm --workspace @sandustry/blueprint-core test && npm --workspace @sandustry/blueprint-node test && npm --workspace @sandustry/save-core test && npm --workspace @sandustry/ui test && npm --workspace @sandustry/blueprint-site test",
    "test": "bun test scripts/test-catalog-invariants.test.ts",
    "tsc:tests": "tsc --noEmit -p tsconfig.tests.json",
    "tsc": "tsc --noEmit",
    "visual:diff": "bun packages/sandustry-blueprint-core/tests/visual/render-visual.mjs --diff",
    "visual:render": "bun packages/sandustry-blueprint-core/tests/visual/render-visual.mjs",
    "visual:update": "bun packages/sandustry-blueprint-core/tests/visual/render-visual.mjs --update"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "bun": "^1.4.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "fsevents": true,
    "bun@1.4.0": true,
    "esbuild@0.28.2": true
  }
}
