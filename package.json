{
  "name": "sandustry-mods",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "tsc": "tsc --noEmit",
    "lint": "node scripts/check-jsx.mjs && oxlint --ignore-pattern '**/build/**' --ignore-pattern 'resources/**' --ignore-pattern '*.zip' tests scripts types mods",
    "check": "npm run tsc && npm run lint && npm run test:catalog",
    "test:blueprint": "node scripts/test-blueprint-core.mjs",
    "test:catalog": "node scripts/test-catalog-invariants.mjs",
    "visual:render": "node scripts/render-blueprint-visual.mjs",
    "visual:diff": "node scripts/render-blueprint-visual.mjs --diff",
    "catalog:extract": "node scripts/extract-native-catalog.mjs",
    "format:bundles": "node scripts/format-bundles.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  }
}
