{
  "manifestVersion": 1,
  "id": "sorahn.sandustry-jailbreak-limits",
  "name": "Jailbreak Building Limits",
  "version": "0.1.1",
  "apiVersion": 1,
  "author": "sorahn",
  "entry": "entry.js",
  "description": "Removes placement limits on the Fluxite Emanator and the Void Rift.",
  "dependencies": [],
  "loadOrder": 1000,
  "configSchema": {
    "uncapAll": {
      "type": "boolean",
      "default": false,
      "labelKey": "Uncap all structures globally",
      "descriptionKey": "When enabled, removes placement limits for every structure in the game instead of only target structures."
    },
    "uncapFluxiteGenerator": {
      "type": "boolean",
      "default": true,
      "labelKey": "Uncap Fluxite Emanators",
      "descriptionKey": "Allow placing unlimited Fluxite Emanators."
    },
    "uncapVoidSeedSpawner": {
      "type": "boolean",
      "default": true,
      "labelKey": "Uncap Void Rifts",
      "descriptionKey": "Allow placing unlimited Void Rifts."
    }
  }
}
